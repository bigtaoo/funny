{
  // 主游戏 client（web 包）的静态托管（Cloudflare Workers static assets），对外 nivara.gamestao.com（品牌域名）+ a.gamestao.com（沿用旧入口）。
  // 与 animator 各一份 wrangler 配置、各一个 Worker，互不影响。
  //
  // 构建（地址烘焙到 api.gamestao.com）：
  //   cd client && NW_API_BASE=https://api.gamestao.com/api \
  //     NW_GATEWAY_WS=wss://api.gamestao.com/gw \
  //     NW_WORLD_BASE=https://api.gamestao.com \
  //     NW_SOCIAL_BASE=https://api.gamestao.com npm run build:web
  // 部署（从仓库根读本文件，把 client/dist 作为静态资源发布）：
  //   npx wrangler deploy -c wrangler/client.jsonc
  //
  // routes.custom_domain=true 会自动建 DNS + 边缘证书（橙云代理）。
  // 设计：design/product/deploy-cloudflare.md §6
  "name": "nivara-client",
  "compatibility_date": "2025-06-01",
  // 只有 /review/*（App Review 录屏）先过 Worker：静态资源对 Range 请求一律回 200，Safari 不播这种 MP4，
  // Worker 自己切出 206。其余路径不经 Worker，照旧纯静态。见 worker.client.js。
  "main": "worker.client.js",
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/review/*"]
  },
  "routes": [
    { "pattern": "a.gamestao.com", "custom_domain": true },
    { "pattern": "nivara.gamestao.com", "custom_domain": true }
  ]
}
