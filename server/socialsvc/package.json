{
  "name": "@nw/socialsvc",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run gen:api:social",
    "build": "tsc -b",
    "pretypecheck": "npm run gen:api:social",
    "typecheck": "tsc --noEmit",
    "predev": "npm run gen:api:social",
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "pretest": "npm run gen:api:social",
    "test": "vitest run",
    "test:coverage": "npm run pretest --if-present && vitest run --coverage",
    "gen:api:social": "node ../contracts/scripts/gen-openapi-social.mjs",
    "gen:api:social:check": "node ../contracts/scripts/gen-openapi-social.mjs --check"
  },
  "dependencies": {
    "@nw/shared": "*",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "js-yaml": "^4.1.0",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
