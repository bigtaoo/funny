require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

# iOS 15.0, not 13.0 (2026-09-07). Two reasons that arrived together: StoreKit 2 (the purchase flow
# in AppDelegate.swift) requires iOS 15, and the App Store's own upload warning 90068 says a
# MinimumOSVersion below 15.0 stops being accepted for upload or submission from spring 2027. There
# are zero installed users, so nothing is dropped by moving. Keep this in step with
# IPHONEOS_DEPLOYMENT_TARGET in App.xcodeproj -- assertDeploymentTarget below fails the pod install
# if they disagree.
platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'

end

target 'App' do
  capacitor_pods
  # Add your Pods here
  # Pinned to the major version that is actually known to build. Left unconstrained until
  # 2026-09-07, which meant every CI run resolved whatever was newest that day: the bridge in
  # AppDelegate.swift was written on 2026-07-21 against v12's API names and first compiled -- seven
  # weeks later -- against 13.9.0, a major bump nobody chose. It happened to still compile; the v9
  # -> v10 bump that renamed every GADXxx symbol to Xxx would not have.
  #
  # 13.9.0 is what shipped in run #4 (read out of GoogleMobileAdsResources.bundle inside the
  # uploaded IPA, not inferred). `~> 13.9` keeps patch and minor fixes flowing and stops the next
  # major from arriving unannounced. Bump it deliberately, after checking the release notes for
  # renamed APIs -- nothing here can compile-check Swift, so a surprise major is found in CI at best.
  pod 'Google-Mobile-Ads-SDK', '~> 13.9'
end

post_install do |installer|
  assertDeploymentTarget(installer)
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end
end
